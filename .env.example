FC_API_BASE=
FC_API_KEY=
# Optional single-user web/API guard. Use a reverse proxy and TLS for remote access.
FC_AUTH_TOKEN=
# Optional provider-specific headers as a JSON object. Never commit real values.
FC_EXTRA_HEADERS=
# Optional session identifier required by some providers.
FC_SESSION_ID=
FC_MODEL=deepseek-v4.1-flash
# Keep this different from FC_MODEL; same-model review can repeat the same error.
FC_REVIEW_MODEL=mimo-v2.6-flash
# Use your actual contact information for online SEC requests.
FC_SEC_USER_AGENT=
FC_EMBEDDING_MODE=local
FC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Anchor relevance is followed by a small, deterministic near-duplicate penalty;
# anchor/rrf remain available for comparison and regression tests.
FC_RERANK_MODE=diversity
FC_MAX_ROUNDS=8
FC_MAX_TOOL_CALLS=20
FC_MODEL_MAX_TOKENS=8192
# Conservative public default; a provider with a higher request limit can use 5 locally.
FC_MIN_MODEL_INTERVAL=21
FC_MODEL_TIMEOUT=60
FC_REVIEW_TIMEOUT=300
# Optional provider sampling controls for repeatable A/B runs. Leave blank if
# the provider rejects these fields (common for reasoning models).
FC_MODEL_TEMPERATURE=
FC_MODEL_TOP_P=
FC_MODEL_SEED=
# Optional USD prices per million tokens. Without these, saved usage reports
# token counts but deliberately does not invent a dollar cost.
FC_MODEL_INPUT_PRICE_PER_MILLION=
FC_MODEL_OUTPUT_PRICE_PER_MILLION=
# Optional per-research USD ceiling. Enforced only when both prices above are set.
FC_MAX_COST_USD=
# Cooperative whole-research ceiling in seconds. 3000 gives narrative
# questions room for several evidence passes without the old 300-second cutoff.
# Set to 0/none only for an explicitly unlimited experiment.
FC_RESEARCH_TIMEOUT=3000
FC_REFRESH_TIMEOUT=180
# Watchlist triggers are opt-in and only run from an explicit scan request.
# The scan reports candidates either way; only an enabled policy starts jobs.
FC_WATCHLIST_TRIGGERS_ENABLED=false
FC_WATCHLIST_TRIGGER_FORMS=10-K,10-Q,8-K
FC_WATCHLIST_TRIGGER_LOOKBACK_DAYS=30
FC_WATCHLIST_TRIGGER_MAX_PER_SCAN=3
FC_MODEL_ATTEMPTS=3
FC_RETRY_BASE_DELAY=1
FC_RETRY_MAX_DELAY=60
# Optional JSON overlay for company aliases, metrics, ratios, search terms and currencies.
FC_DOMAIN_CONFIG=
FC_HOME=.filingcopilot

# Includes reasoning tokens; leave room for the structured verdict itself.
FC_REVIEW_MAX_TOKENS=16384
# Number of narrative claims sent to the independent reviewer per call.
FC_REVIEW_BATCH_SIZE=4
# Optional independent US daily-price fallback; no key is sent to Yahoo or the LLM.
FC_TWELVE_DATA_API_KEY=

# Disclosure monitoring v1. Deterministic briefs by default; a model call is
# opt-in and capped at one call per brief.
FC_MONITORING_ENABLED=true
FC_MONITORING_USE_MODEL=false

# OpenCode Console / Go examples:
# Pay-as-you-go: FC_API_BASE=https://opencode.ai/inference/openai/v1
# Go:            FC_API_BASE=https://opencode.ai/inference/go/openai/v1
# OpenCode Go also needs a stable session id and the HTTP model ids:
# FC_SESSION_ID=fc-monitor-<stable-id>
# FC_MODEL=deepseek-v4.1-flash
# FC_REVIEW_MODEL=mimo-v2.6-flash
# Optional webhook for POST /api/monitoring/cases/{id}/deliver (Slack/Teams/etc.)
FC_MONITORING_WEBHOOK_URL=
# Optional background scan loop in `serve`; 0 disables it.
FC_MONITORING_SCAN_INTERVAL_MINUTES=0

# Daily monitoring digest (07:00 local by default). channel: local|webhook|smtp
FC_MONITORING_DIGEST_ENABLED=false
FC_MONITORING_DIGEST_HOUR=7
FC_MONITORING_DIGEST_CHANNEL=local
# SMTP (only needed for channel=smtp)
FC_SMTP_HOST=
FC_SMTP_PORT=587
FC_SMTP_USER=
FC_SMTP_PASSWORD=
FC_SMTP_FROM=
FC_SMTP_TO=
FC_SMTP_STARTTLS=true
# Native Slack incoming webhook (digest channel=slack)
FC_SLACK_WEBHOOK_URL=
# Brief model hard budget: one request, bounded time/tokens/cost.
FC_MONITORING_BRIEF_TIMEOUT=30
FC_MONITORING_BRIEF_MAX_TOKENS=2048
FC_MONITORING_BRIEF_MAX_COST_USD=
